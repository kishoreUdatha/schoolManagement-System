<?xml version="1.0" encoding="utf-8"?>
<!--
  Android refuses plain HTTP unless an app says otherwise. The server's address
  is typed in on the phone (www/index.html) and is usually a computer on the
  local network without a certificate, so plain HTTP is allowed to any address.
  Once the server is hosted over HTTPS, delete this file and the manifest line
  that points at it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
